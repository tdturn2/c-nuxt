{
  "name": "connect",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "private": true,
  "overrides": {
    "@tiptap/core": "3.19.0",
    "@tiptap/pm": "3.19.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:clean": "sh -c 'for p in 3000 3001; do lsof -ti:$p | xargs kill -9 2>/dev/null; done; ulimit -n 10000; exec nuxt dev --port 3000'",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate:course-offering-patterns": "node scripts/generate-course-offering-patterns.mjs --include-fa26",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/icon": "^1.7.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.4.0",
    "@sidebase/nuxt-auth": "^1.2.0",
    "@tiptap/extension-table": "3.19.0",
    "@vueuse/core": "^11.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "howler": "^2.2.4",
    "i18n-iso-countries": "^7.14.0",
    "jose": "^6.2.2",
    "next-auth": "~4.21.1",
    "nuxt": "^4.3.0",
    "plyr": "^3.8.4",
    "radix-vue": "^1.9.2",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.1.18",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.1.4"
  }
}
